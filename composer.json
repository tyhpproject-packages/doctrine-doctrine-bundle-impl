{
    "name": "tyhpdef/doctrine-doctrine-bundle-impl",
    "description": "Implementation package for tyhpdef/doctrine-doctrine-bundle. Require tyhpdef/doctrine-doctrine-bundle, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.3.2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-doctrine-bridge": "@dev",
                "tyhpdef/symfony-service-contracts": "@dev",
                "tyhpdef/symfony-dependency-injection": "@dev",
                "tyhpdef/doctrine-dbal": "@dev",
                "tyhpdef/doctrine-persistence": "@dev",
                "tyhpdef/doctrine-orm": "@dev",
                "tyhpdef/doctrine-collections": "@dev",
                "tyhpdef/doctrine-deprecations": "@dev",
                "tyhpdef/doctrine-event-manager": "@dev",
                "tyhpdef/doctrine-inflector": "@dev",
                "tyhpdef/doctrine-lexer": "@dev",
                "tyhpdef/psr-cache": "@dev",
                "tyhpdef/psr-container": "@dev",
                "tyhpdef/psr-event-dispatcher": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/php-ext-bcmath": "@dev",
                "tyhpdef/php-ext-ctype": "@dev",
                "tyhpdef/php-ext-mysqli": "@dev",
                "tyhpdef/php-ext-pdo": "@dev",
                "tyhpdef/php-ext-pgsql": "@dev",
                "tyhpdef/php-ext-sqlite3": "@dev",
                "tyhpdef/symfony-console": "@dev",
                "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
                "tyhpdef/symfony-string": "@dev",
                "tyhpdef/symfony-translation-contracts": "@dev",
                "tyhpdef/symfony-var-exporter": "@dev",
                "tyhpdef/symfony-http-kernel": "@dev",
                "tyhpdef/symfony-http-foundation": "@dev",
                "tyhpdef/symfony-error-handler": "@dev",
                "tyhpdef/symfony-event-dispatcher": "@dev",
                "tyhpdef/symfony-var-dumper": "@dev",
                "tyhpdef/php-ext-session": "@dev",
                "tyhpdef/symfony-uid": "@dev",
                "tyhpdef/symfony-validator": "@dev",
                "tyhpdef/php-ext-dom": "@dev",
                "tyhpdef/php-ext-simplexml": "@dev",
                "tyhpdef/symfony-config": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/doctrine-doctrine-bundle"
        }
    },
    "require": {
        "php": ">=8.2",
        "doctrine/doctrine-bundle": "3.3.2"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-doctrine-bridge": "@dev",
        "tyhpdef/symfony-service-contracts": "@dev",
        "tyhpdef/symfony-dependency-injection": "@dev",
        "tyhpdef/doctrine-dbal": "@dev",
        "tyhpdef/doctrine-persistence": "@dev",
        "tyhpdef/doctrine-orm": "@dev",
        "tyhpdef/doctrine-collections": "@dev",
        "tyhpdef/doctrine-deprecations": "@dev",
        "tyhpdef/doctrine-event-manager": "@dev",
        "tyhpdef/doctrine-inflector": "@dev",
        "tyhpdef/doctrine-lexer": "@dev",
        "tyhpdef/psr-cache": "@dev",
        "tyhpdef/psr-container": "@dev",
        "tyhpdef/psr-event-dispatcher": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/php-ext-bcmath": "@dev",
        "tyhpdef/php-ext-ctype": "@dev",
        "tyhpdef/php-ext-mysqli": "@dev",
        "tyhpdef/php-ext-pdo": "@dev",
        "tyhpdef/php-ext-pgsql": "@dev",
        "tyhpdef/php-ext-sqlite3": "@dev",
        "tyhpdef/symfony-console": "@dev",
        "tyhpdef/symfony-event-dispatcher-contracts": "@dev",
        "tyhpdef/symfony-string": "@dev",
        "tyhpdef/symfony-translation-contracts": "@dev",
        "tyhpdef/symfony-var-exporter": "@dev",
        "tyhpdef/symfony-http-kernel": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev",
        "tyhpdef/symfony-error-handler": "@dev",
        "tyhpdef/symfony-event-dispatcher": "@dev",
        "tyhpdef/symfony-var-dumper": "@dev",
        "tyhpdef/php-ext-session": "@dev",
        "tyhpdef/symfony-uid": "@dev",
        "tyhpdef/symfony-validator": "@dev",
        "tyhpdef/php-ext-dom": "@dev",
        "tyhpdef/php-ext-simplexml": "@dev",
        "tyhpdef/symfony-config": "@dev"
    }
}
